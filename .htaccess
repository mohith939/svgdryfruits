<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Block access to hidden files, git, env, sqlite, sql
    RewriteRule ^(\.git|\.env|config|src|views)/ - [F,L]
    RewriteRule ^database/(?!install\.php).*$ - [F,L]

    # Allow direct access to real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other URLs to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Block access to sensitive file patterns
<FilesMatch "^\.|\.env|\.sqlite|\.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
